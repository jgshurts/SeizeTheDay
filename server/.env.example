DATABASE_URL="postgresql://seize_the_day:<password>@localhost:5432/seize_the_day?schema=public"
# Neon (hosted): `neon env pull` writes DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED to .env.local at the repo root. Run the app with the
# pooled URL plus "&pgbouncer=true", and run migrations over the direct one:
#   DATABASE_URL="$DATABASE_URL_UNPOOLED" npx prisma migrate deploy
JWT_SECRET="change-me-in-local-env"
PORT=4000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add GOOGLE_REDIRECT_URI as an authorized
# redirect URI, and enable the Google Calendar API for the project.
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<client-secret>"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Where the client dev server runs -- the OAuth callback redirects here
# with the session token once login completes.
CLIENT_URL="http://localhost:5174"
