DATABASE_URL="postgresql://seize_the_day:<password>@localhost:5432/seize_the_day?schema=public"
# Neon (hosted): `neon env pull --file .env.db.prod` writes DATABASE_URL
# (pooled) and DATABASE_URL_UNPOOLED to .env.db.prod at the repo root
# (gitignored). Run the app with the pooled URL plus "&pgbouncer=true", and
# run migrations over the direct one:
#   set -a; source .env.db.prod; set +a
#   DATABASE_URL="$DATABASE_URL_UNPOOLED" npx prisma migrate deploy
JWT_SECRET="change-me-in-local-env"
PORT=4000

# Where invite links point (used by `npm run user:invite`). Defaults to the
# local client dev server.
APP_URL="http://localhost:5174"

# When the API runs behind a load balancer, the number of proxies in front of
# it (1 for a single ALB), so the login rate limit sees real client IPs.
# TRUST_PROXY=1
