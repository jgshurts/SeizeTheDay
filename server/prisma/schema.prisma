generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt  @id @default(autoincrement())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  nickname  String  @unique
  email     String  @unique
  googleId  String? @unique @map("google_id")
  avatarUrl String? @map("avatar_url")

  // Legacy from when sign-in and calendar access went through Google OAuth.
  // Nothing reads these any more; kept (unused) so the move to passwords is
  // reversible, and safe to drop in a later migration.
  googleRefreshToken String? @map("google_refresh_token")

  // Sign-in is by password (bcrypt hash). Null until the user accepts their
  // invite and chooses one.
  passwordHash String? @map("password_hash")

  // One-time invite / password-reset link. Only the SHA-256 of the token is
  // stored, so a database leak doesn't hand out working links.
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")

  // Private iCal feed address (Google Calendar > Settings > "Secret address
  // in iCal format") shown in the Schedule column. It grants read access to
  // the calendar, so it's never returned by the API.
  calendarIcalUrl String? @map("calendar_ical_url")

  // Per-user theming (Settings > Theme). Images are stored as data URLs
  // directly on the row -- small enough for a personal planner's own photos
  // that it's not worth standing up separate file storage for them.
  themeBannerColor     String? @map("theme_banner_color")
  themeSubBannerColor  String? @map("theme_sub_banner_color")
  themeBackgroundColor String? @map("theme_background_color")
  themeLeftImage       String? @map("theme_left_image") @db.Text
  themeRightImage      String? @map("theme_right_image") @db.Text

  // Admins manage the shared Statuses and Priority Groups and the Users
  // list (who's invited to sign in); everyone else manages only their own
  // projects, tasks, notes and theme.
  isAdmin Boolean @default(false) @map("is_admin")

  ownedTasks       Task[]            @relation("TaskOwner")
  assignedTasks    Task[]            @relation("TaskAssignee")
  notes            Note[]
  projects         Project[]
  eventProjectTags EventProjectTag[]
  recurringTasks   RecurringTask[]

  @@map("users")
}

model PriorityGroup {
  id          BigInt  @id @default(autoincrement())
  prty        Int
  prtyCode    String  @map("prty_code") @db.Char(1)
  description String?

  tasks          Task[]
  recurringTasks RecurringTask[]

  @@map("priority_groups")
}

model Status {
  id              BigInt  @id @default(autoincrement())
  statusCode      String  @map("status_code") @db.Char(1)
  isComplete      Boolean @default(false) @map("is_complete")
  // Marks which status means "blocked" -- lets a task's blocker-note UI
  // (Task.blockerNoteId) key off the status itself rather than guessing
  // from its name, since statuses are otherwise entirely user-defined.
  isBlocked       Boolean @default(false) @map("is_blocked")
  backgroundColor String? @map("background_color")
  foregroundColor String? @map("foreground_color")
  description     String?
  ordinal         Int
  isDefault       Boolean @default(false) @map("is_default")

  tasks Task[]

  @@map("statuses")
}

// Per-user: each user sees and assigns only their own projects. A task
// delegated to someone else keeps its owner's project, which the assignee
// sees but can't change.
model Project {
  id          BigInt  @id @default(autoincrement())
  ownerId     BigInt  @map("owner_id")
  name        String
  description String?
  color       String?

  owner          User              @relation(fields: [ownerId], references: [id])
  tasks          Task[]
  notes          Note[]
  eventTags      EventProjectTag[]
  recurringTasks RecurringTask[]

  @@map("projects")
}

// Tags a specific Google Calendar event (identified by its Google event id,
// scoped per user since two users could see the same event with different
// ids across calendars) with a Project, purely so the Schedule column can
// color it -- Google Calendar has no concept of our Projects itself.
model EventProjectTag {
  id            BigInt @id @default(autoincrement())
  userId        BigInt @map("user_id")
  googleEventId String @map("google_event_id")
  projectId     BigInt @map("project_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@map("event_project_tags")
}

model Task {
  id              BigInt    @id @default(autoincrement())
  projectId       BigInt?   @map("project_id")
  ownerId         BigInt    @map("owner_id")
  assigneeId      BigInt    @map("assignee_id")
  priorityGroupId BigInt?   @map("priority_group_id")
  statusId        BigInt?   @map("status_id")
  // The "known place" for what's blocking a Blocked task and who owns
  // clearing it, set explicitly rather than inferred from status.
  blockerNoteId   BigInt?   @map("blocker_note_id")
  prtyOrdinal     Int?      @map("prty_ordinal")
  description     String
  createdAt       DateTime  @default(now()) @map("created_at")
  datePlanned     DateTime  @map("date_planned") @db.Date
  completedAt     DateTime? @map("completed_at")
  // Set on tasks generated from a recurring series (see RecurringTask). The
  // unique pair below is what lets generation be re-run safely: an
  // occurrence for a given series and date can only exist once. Null for
  // ordinary tasks, which the constraint ignores.
  seriesId        BigInt?   @map("series_id")

  series        RecurringTask? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id])
  owner         User           @relation("TaskOwner", fields: [ownerId], references: [id])
  assignee      User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  priorityGroup PriorityGroup? @relation(fields: [priorityGroupId], references: [id])
  status        Status?        @relation(fields: [statusId], references: [id])
  blockerNote   Note?          @relation("TaskBlockerNote", fields: [blockerNoteId], references: [id], onDelete: SetNull)

  @@unique([seriesId, datePlanned])
  @@map("tasks")
}

// Visible to its owner, and also to the assignee of any task delegated to
// them that links it (as blocker note, or "@REF" in the description).
model Note {
  id          BigInt   @id @default(autoincrement())
  ownerId     BigInt   @map("owner_id")
  projectId   BigInt?  @map("project_id")
  shortRef    String?  @map("short_ref") @db.VarChar(10)
  noteText    String?  @map("note_text")
  createdAt   DateTime @default(now()) @map("created_at")
  contextDate DateTime @map("context_date") @db.Date

  owner        User     @relation(fields: [ownerId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])
  blockedTasks Task[]   @relation("TaskBlockerNote")

  @@map("notes")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// A repeating task, e.g. "take out the trash" every Tuesday. It is only a
// template: the server turns it into ordinary Task rows (linked by
// Task.seriesId) over a rolling window ahead of today, so everything that
// works on a task -- status, notes, moving it, search -- works on an
// occurrence too. See lib/recurrence.ts for how the fields below combine.
model RecurringTask {
  id               BigInt              @id @default(autoincrement())
  ownerId          BigInt              @map("owner_id")
  projectId        BigInt?             @map("project_id")
  priorityGroupId  BigInt?             @map("priority_group_id")
  description      String
  frequency        RecurrenceFrequency
  // Every N days / weeks / months / years.
  interval         Int                 @default(1)
  // WEEKLY: which days of the week, 0 = Sunday .. 6 = Saturday.
  weekdays         Int[]
  // MONTHLY / YEARLY: day of the month, 1-31, or -1 for the last day.
  // Days a month doesn't have (the 31st in April) fall on its last day.
  monthDay         Int?                @map("month_day")
  // YEARLY: month, 1-12.
  month            Int?
  startDate        DateTime            @map("start_date") @db.Date
  // Optional "until" date; null repeats indefinitely.
  endDate          DateTime?           @map("end_date") @db.Date
  // When true, an occurrence nobody finished is dropped once its day has
  // passed, instead of lingering in the Unfinished list.
  skipIfMissed     Boolean             @default(false) @map("skip_if_missed")
  // The last day occurrences have been created for. Generation only ever
  // looks past this, so an occurrence the user deleted ("skip this Tuesday")
  // isn't quietly recreated on the next sync. Null until first generated.
  generatedThrough DateTime?           @map("generated_through") @db.Date
  createdAt        DateTime            @default(now()) @map("created_at")

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priorityGroup PriorityGroup? @relation(fields: [priorityGroupId], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@map("recurring_tasks")
}
